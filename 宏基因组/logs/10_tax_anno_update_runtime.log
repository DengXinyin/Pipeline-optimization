=== 开始执行: diamond blastx ===

set -euo pipefail
file_size=$(du -b /prodigal/unique_gene.fasta | awk '{print $1}')
if [ "$file_size" -gt 16106127360 ]; then
    echo "File is larger than 15GB, performing fast operation..."
    diamond blastx --threads 60 --fast --log --tmpdir /workdir/tax_anno_update/tmp         --db /metagenome-DB/database/NR/metage2 -q /prodigal/unique_gene.fasta         --max-target-seqs 10 --evalue 1e-5 -o /workdir/tax_anno_update/unique.daa --outfmt 100 
else
    echo "File is smaller than 15GB, performing default operation..."
    diamond blastx --threads 60 --log --tmpdir /workdir/tax_anno_update/tmp         --db /metagenome-DB/database/NR/metage2 -q /prodigal/unique_gene.fasta         --max-target-seqs 10 --evalue 1e-5 -o /workdir/tax_anno_update/unique.daa --outfmt 100 
fi

